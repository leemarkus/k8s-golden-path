# Resolve both digest arguments using ops/ci/README.md before building.
ARG NODE_DIGEST
ARG NGINX_DIGEST
FROM node:22-alpine@${NODE_DIGEST} AS builder
WORKDIR /build
# TENANT EDIT: replace only this builder body with your own locked build.
# The zero-dependency example emits dist/; preserve that output contract.
COPY package.json build.mjs index.html ./
RUN npm run build

FROM nginxinc/nginx-unprivileged:alpine@${NGINX_DIGEST} AS runner
ARG SOURCE_URL
ARG REVISION
ARG CREATED
LABEL org.opencontainers.image.source="${SOURCE_URL}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.created="${CREATED}" \
      org.opencontainers.image.title="{{tenant}}"
COPY nginx.conf /etc/nginx/nginx.conf
COPY --from=builder --chown=101:101 /build/dist/ /usr/share/nginx/html/
USER 101:101
EXPOSE {{port}}
# Kubernetes mounts an emptyDir at /tmp (fsGroup 101); no other writes needed.
# Bypass the upstream entrypoint's config rewriting on a read-only root.
ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:{{port}}{{health_path}} || exit 1
