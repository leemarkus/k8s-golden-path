ARG NODE_DIGEST
FROM node:22-alpine@${NODE_DIGEST} AS builder
WORKDIR /build
# TENANT EDIT: add a locked dependency/build step here if your app needs one.
COPY package.json server.mjs ./
RUN node --check server.mjs

FROM node:22-alpine@${NODE_DIGEST} AS runner
ARG SOURCE_URL
ARG REVISION
ARG CREATED
LABEL org.opencontainers.image.source="${SOURCE_URL}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.created="${CREATED}" \
      org.opencontainers.image.title="{{tenant}}"
ENV NODE_ENV=production
WORKDIR /app
COPY --from=builder --chown=1000:1000 /build/ ./
USER 1000:1000
EXPOSE {{port}}
# No runtime disk writes. If adding scratch writes, mount emptyDir at /tmp.
CMD ["node", "server.mjs"]
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 CMD node -e "fetch('http://127.0.0.1:{{port}}{{health_path}}').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
