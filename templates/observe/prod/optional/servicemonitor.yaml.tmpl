{
  "apiVersion": "monitoring.coreos.com/v1",
  "kind": "ServiceMonitor",
  "metadata": {
    "name": "{{tenant}}-metrics",
    "namespace": "{{tenant}}-prod",
    "labels": {
      "app.kubernetes.io/name": "{{tenant}}",
      "tenant": "{{tenant}}",
      "env": "prod",
      "release": "kube-prometheus-stack"
    }
  },
  "spec": {
    "namespaceSelector": {
      "matchNames": [
        "{{tenant}}-prod"
      ]
    },
    "selector": {
      "matchLabels": {
        "app.kubernetes.io/name": "{{tenant}}",
        "golden-path/metrics": "enabled"
      }
    },
    "endpoints": [
      {
        "port": "metrics",
        "path": "/metrics",
        "interval": "30s",
        "scrapeTimeout": "10s",
        "honorLabels": false
      }
    ]
  }
}
