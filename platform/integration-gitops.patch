@@ -80,6 +80,7 @@ jobs:
           # validated in the kustomize-overlays job instead.
           find clusters/homelab -type f -name "*.yaml" \
             -not -path "*/values/*" \
+            -not -path "*/tenants/*/base/observe/tests/*" \
             -not -name "kustomization.yaml" \
             | sort > /tmp/manifests.txt
           echo "validating $(wc -l < /tmp/manifests.txt) manifests:"
@@ -101,7 +102,7 @@ jobs:
           xargs -a /tmp/manifests.txt kubeconform \
             -strict \
             -kubernetes-version 1.34.0 \
-            -skip CustomResourceDefinition,Application,AppProject,Certificate,ClusterIssuer,Issuer,PrometheusRule,ServiceMonitor,PodMonitor,Prometheus,Alertmanager,ScrapeConfig,CiliumLoadBalancerIPPool,CiliumL2AnnouncementPolicy,CiliumNetworkPolicy,ClusterPolicy,Policy,SealedSecret,Backup,RecurringJob,Schedule,Plan \
+            -skip CustomResourceDefinition,Application,ApplicationSet,AppProject,PolicyException,Certificate,ClusterIssuer,Issuer,PrometheusRule,ServiceMonitor,PodMonitor,Prometheus,Alertmanager,ScrapeConfig,CiliumLoadBalancerIPPool,CiliumL2AnnouncementPolicy,CiliumNetworkPolicy,ClusterPolicy,Policy,SealedSecret,Backup,RecurringJob,Schedule,Plan \
             -summary

       - name: every PrometheusRule carries the label that makes it load
@@ -167,7 +168,7 @@ jobs:
               | kubeconform \
                   -strict \
                   -kubernetes-version 1.34.0 \
-                  -skip CustomResourceDefinition,Application,AppProject,Certificate,ClusterIssuer,Issuer,PrometheusRule,ServiceMonitor,PodMonitor,Prometheus,Alertmanager,CiliumLoadBalancerIPPool,CiliumL2AnnouncementPolicy,CiliumNetworkPolicy,ClusterPolicy,Policy,SealedSecret,Backup,RecurringJob,Schedule,Plan \
+                  -skip CustomResourceDefinition,Application,ApplicationSet,AppProject,PolicyException,Certificate,ClusterIssuer,Issuer,PrometheusRule,ServiceMonitor,PodMonitor,Prometheus,Alertmanager,CiliumLoadBalancerIPPool,CiliumL2AnnouncementPolicy,CiliumNetworkPolicy,ClusterPolicy,Policy,SealedSecret,Backup,RecurringJob,Schedule,Plan \
                   -summary
           done < <(find clusters/homelab -path "*/overlays/*" -name kustomization.yaml | sort)
           [ "$found" -eq 1 ] || echo "[i] no overlays yet — nothing to render"
@@ -232,6 +233,7 @@ jobs:
           find clusters/homelab -type f -name "*.yaml" \
             -not -path "*/values/*" \
             -not -path "*/hq/*" \
+            -not -path "*/tenants/*" \
             -not -name "kustomization.yaml" > /tmp/kres.txt

           ARGS=""
@@ -241,7 +243,8 @@ jobs:
           kyverno apply clusters/homelab/config/kyverno-policies.yaml $ARGS | tee /tmp/kyv-raw.txt

           echo "=== rendered kustomize overlays ==="
-          for o in clusters/homelab/hq/overlays/*/; do
+          while IFS= read -r kfile; do
+            o=$(dirname "$kfile")
             echo "--- $o"
             # `kustomize build`, not `kubectl kustomize`: THERE IS NO KUBECTL ON
             # THIS RUNNER and there should not be — it holds no cluster
@@ -252,7 +255,7 @@ jobs:
             kustomize build "$o" > /tmp/rendered.yaml
             kyverno apply clusters/homelab/config/kyverno-policies.yaml \
               --resource /tmp/rendered.yaml | tee -a /tmp/kyv-rendered.txt
-          done
+          done < <(find clusters/homelab -path "*/overlays/*" -name kustomization.yaml | sort)

           FAILED=$(grep -ho "fail: [0-9]*" /tmp/kyv-raw.txt /tmp/kyv-rendered.txt \
                    | awk '{s+=$2} END {print s+0}')
@@ -465,6 +468,16 @@ jobs:
           trivy config clusters/homelab --severity HIGH,CRITICAL --exit-code 0 \
             --format sarif --output $TRIVY_SARIF_DIR/config.sarif || true

+          # the guard stage: tenant IaC has no inherited platform backlog allowance.
+          tenant_scan_dir=$(mktemp -d)
+          trap 'rm -rf "$tenant_scan_dir"' EXIT
+          if [ -d clusters/homelab/tenants ]; then
+            while IFS= read -r kfile; do
+              kustomize build "$(dirname "$kfile")" > "$tenant_scan_dir/rendered.yaml"
+              trivy config "$tenant_scan_dir" --severity HIGH,CRITICAL --exit-code 1
+            done < <(find clusters/homelab/tenants -path "*/overlays/*" -name kustomization.yaml | sort)
+          fi
+
           echo "=== trivy image (gated against baseline) ==="
           # Images are read out of the manifests, so a new pin is scanned the
           # day it lands and nobody has to remember to register it here.
diff --git a/clusters/homelab/apps/appproject-platform.yaml b/clusters/homelab/apps/appproject-platform.yaml
index 9be5d8c..69ab928 100644
--- a/clusters/homelab/apps/appproject-platform.yaml
+++ b/clusters/homelab/apps/appproject-platform.yaml
@@ -126,11 +126,18 @@ spec:
     # project (the second-lander rule from both branches' promote notes).
     - server: https://kubernetes.default.svc
       namespace: trivy-system
+    # First first-tenant acceptance tenant only. Register later tenant budgets explicitly.
+    - server: https://kubernetes.default.svc
+      namespace: website-dev
+    - server: https://kubernetes.default.svc
+      namespace: website-prod

   # See the header: platform components install cluster-scoped objects by
   # definition. Restricting this kind-by-kind would produce a list that has to be
   # edited on every chart bump, and a fence that has to be widened routinely
   # stops being a fence.
+  # Platform also owns tenant namespace quotas and LimitRanges. Tenant
+  # Applications remain in the separate namespaced-only tenants project.
   clusterResourceWhitelist:
     - group: '*'
       kind: '*'
